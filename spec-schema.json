{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VideoRequirementSpec",
  "description": "1번 파트 최종 export 포맷. 2번 파트(영상 생성 에이전트)의 입력.",
  "type": "object",
  "required": ["paper", "items"],
  "properties": {
    "paper": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": { "type": "string" },
        "file": { "type": "string", "description": "원본 PDF 파일명" }
      }
    },
    "confirmed_at": {
      "type": "string",
      "format": "date-time",
      "description": "사용자 확정 시각"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "section", "content", "source"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^R\\d+$",
            "description": "반복 수정 중 항목 추적용. 한번 부여되면 재사용·재번호 금지"
          },
          "section": {
            "enum": ["intro", "related_work", "method", "experiment", "result", "conclusion", "other"]
          },
          "content": {
            "type": "string",
            "description": "영상에서 반드시 다뤄야 할 내용 (한 문장 단위)"
          },
          "source": {
            "enum": ["user", "llm"],
            "description": "user = [사용자 강조] 항목. 루프 중 LLM이 삭제 금지"
          },
          "evidence": {
            "type": "object",
            "description": "2번 파트의 영상 소재 탐색용 근거",
            "properties": {
              "pages": { "type": "array", "items": { "type": "integer" } },
              "figures": {
                "type": "array",
                "items": { "type": "string" },
                "description": "예: \"Figure 3\", \"Table 1\", \"Eq. 2\""
              },
              "quote": { "type": "string", "description": "논문 원문 짧은 인용 (선택)" }
            }
          }
        }
      }
    }
  }
}
